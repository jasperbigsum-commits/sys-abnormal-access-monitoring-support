<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jasperbigsum-commits</groupId>
        <artifactId>sys-abnormal-access-monitoring-support</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sys-abnormal-access-monitoring-integration-audit</artifactId>
    <packaging>pom</packaging>
    <name>Abnormal Access Monitoring Integration Audit</name>
    <description>Runnable Spring Boot 2 and Spring Boot 3 baseline web projects.</description>

    <modules>
        <module>spring2-web</module>
        <module>spring3-web</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>verify-acceptance-ids</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target name="verify-acceptance-ids">
                                <mkdir dir="${project.build.directory}/acceptance-id-verifier" />
                                <javac srcdir="${project.basedir}/src/verify/java"
                                       destdir="${project.build.directory}/acceptance-id-verifier"
                                       encoding="UTF-8" source="8" target="8"
                                       includeantruntime="false" />
                                <java classname="AcceptanceIdVerifier" fork="true" failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/acceptance-id-verifier" />
                                    </classpath>
                                    <arg value="${project.basedir}" />
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
